# ============================================================
# ExamArena — Environment Variables Example
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
# ============================================================

# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection URL (e.g. Neon, Supabase, local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require"

# ─── Authentication (Clerk) ─────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_YOUR_CLERK_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="sk_test_YOUR_CLERK_SECRET_KEY"

# ─── JWT (Backend Auth) ─────────────────────────────────────
# Use a strong random secret: `openssl rand -hex 32`
SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_SECRET"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Environment ────────────────────────────────────────────
ENVIRONMENT="development"
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS="http://localhost:3000"

# ─── API URL (Frontend) ─────────────────────────────────────
# Do NOT include /api at the end — backend routes are /api/v1/...
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ─── Redis ──────────────────────────────────────────────────
# Full Redis URL including credentials and port
REDIS_URL="redis://default:PASSWORD@HOST:PORT"
REDIS_CACHE_EXPIRE_SECONDS=3600
REDIS_RATE_LIMIT_EXPIRE_SECONDS=60
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_TIME_WINDOW_SECONDS=60
REDIS_DATABASE_NAME="your-redis-db-name"

# ─── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY="sk-YOUR_OPENAI_API_KEY"

# ─── Cloudinary & Storage Provider ─────────────────────────
CLOUDINARY_APIKEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_APISECRET="YOUR_CLOUDINARY_API_SECRET"
CLOUDINARY_CLOUDNAME="YOUR_CLOUDINARY_CLOUD_NAME"

# Storage provider options: "local" (default for dev/testing) or "cloudinary"
FILE_STORAGE_PROVIDER="local"

# ─── Cohere & Question Import ──────────────────────────────
COHERE_API_KEY="YOUR_COHERE_API_KEY"
COHERE_MODEL="command-r-plus"
QUESTION_IMPORT_MAX_FILE_MB=15
QUESTION_IMPORT_STORAGE_PATH="uploads/question_imports"
QUESTION_IMPORT_MAX_RETRIES=3
QUESTION_IMPORT_TIMEOUT_SECONDS=60.0

# ─── Answer Key Import ─────────────────────────────────────
ANSWER_KEY_IMPORT_MAX_FILE_MB=15
ANSWER_KEY_IMPORT_STORAGE_PATH="uploads/answer_key_imports"
ANSWER_KEY_IMPORT_MAX_RETRIES=3
ANSWER_KEY_IMPORT_TIMEOUT_SECONDS=60.0

# ─── Search-Sphere RAG Microservice ────────────────────────
SEARCH_SPHERE_URL="http://localhost:8000"
SEARCH_SPHERE_API_KEY="ss_live_YOUR_SEARCH_SPHERE_API_KEY"
SEARCH_SPHERE_CLIENT_ID="exam_arena"
SEARCH_SPHERE_TIMEOUT_SECONDS=30.0
